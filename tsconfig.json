{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "strict": true,
        "types": ["node"],

        "declaration": true,
        "rootDir": "sources",
        "outDir": "dist",

        "forceConsistentCasingInFileNames": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",

        // eslint.config.mts выполняет исходники в Node без сборки
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": true,

        "resolveJsonModule": true,
        "isolatedModules": true,
        "skipLibCheck": true,
    },
    "include": [
        "./sources/**/*.ts",
        "./sources/**/*.tsx",
        "./sources/**/*.mts",
    ]
}
